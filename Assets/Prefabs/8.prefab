  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Judith Beheading Holofernes (c. 1612\u20131620) by Artemisia Gentileschi\n\n\nThis
    fiercely intense Baroque masterpiece showcases the biblical heroine Judith and
    her maidservant mid-execution as they brutally decapitate the Assyrian general
    Holofernes to save their people. Gentileschi utilizes a raw, unflinching perspective
    and dramatic tenebrism, rejecting the delicate interpretations of her male peers
    in favor of physical struggle, spurting blood, and muscular tension. Long analyzed
    through an autobiographical lens, the composition serves as a profound testament
    to female agency, grit, and psychological resolve."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
